{
  "atomKeymap.promptV3Features": true,
  "cSpell.userWords": [
    "alloc",
    "allocs",
    "anadev",
    "anaprod",
    "anaqc",
    "artifactory",
    "cachix",
    "Causef",
    "cicd",
    "cooldown",
    "datacenter",
    "Debugf",
    "ecomdev",
    "ecomprod",
    "ecomqc",
    "goarch",
    "golangci",
    "gomock",
    "gorelease",
    "gosec",
    "hashicorp",
    "Infof",
    "infradev",
    "kubernetes",
    "ldap",
    "mockgen",
    "Newf",
    "nixos",
    "nixpkgs",
    "nolint",
    "oidc",
    "SUPABASE",
    "twilio",
    "walletconnect",
    "Warnf",
  ],
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.fixAll.eslint": "explicit",
  },
  "editor.accessibilitySupport": "off",
  "editor.guides.bracketPairs": true,
  "eslint.validate": ["javascript"],
  "extensions.ignoreRecommendations": true,
  "explorer.confirmDragAndDrop": false,
  "files.autoSave": "onFocusChange",
  "files.associations": {
    "Dockerfile*": "dockerfile",
    "docker-compose*": "dockercompose",
    "*.tf": "terraform",
    "*.tfvars": "terraform",
    "*.nomad": "hcl",
    "*.pkr.hcl": "hcl",
    ".env.*": "dotenv",
  },
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.insertFinalNewline": true,
  "git.openRepositoryInParentFolders": "always",
  "gitlens.advanced.fileHistoryFollowsRenames": true,
  "gitlens.advanced.messages": {
    "suppressCommitHasNoPreviousCommitWarning": false,
    "suppressCommitNotFoundWarning": false,
    "suppressFileNotUnderSourceControlWarning": false,
    "suppressGitVersionWarning": false,
    "suppressLineUncommittedWarning": false,
    "suppressNoRepositoryWarning": false,
  },
  "gitlens.keymap": "alternate",
  "gitlens.codeLens.scopes": ["document", "containers"],
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.blame.highlight.locations": ["gutter", "line", "overview"],
  "go.alternateTools": {
    "go-langserver": "gopls",
  },
  "go.useLanguageServer": true,
  "go.buildOnSave": "off",
  "go.vetOnSave": "off",
  "[go]": {
    "editor.snippetSuggestions": "none",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
    },
  },
  "go.toolsManagement.autoUpdate": true,
  "gopls": {
    "usePlaceholders": true,
  },
  "python.linting.lintOnSave": true,
  "python.linting.pylintArgs": ["--load-plugins=pylint_django"],
  "[python]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
  },
  "platformio-ide.disablePIOHomeStartup": true,
  "redhat.telemetry.enabled": false,
  "[rust]": {
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
    },
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
  },
  "rust-analyzer.inlayHints.parameterHints.enable": false,
  "rust-analyzer.inlayHints.bindingModeHints.enable": false,
  "rust-analyzer.inlayHints.typeHints.enable": false,
  "rust-analyzer.inlayHints.chainingHints.enable": false,
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
  },
  "[terraform-vars]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
  },
  "terraform.languageServer.enable": true,
  "terminal.external.osxExec": "warp.app",
  "terminal.explorerKind": "external",
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "terminal.integrated.lineHeight": 1.3,
  "workbench.iconTheme": "vscode-icons",
  "workbench.startupEditor": "newUntitledFile",
  "vsicons.dontShowNewVersionMessage": true,
  "[go][rust]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
    },
  },
  "yaml.format.enable": true,
  "[toml]": {
    "editor.formatOnSave": false,
  },
  "security.promptForLocalFileProtocolHandling": false,
  "makefile.configureOnOpen": true,
  "security.workspace.trust.untrustedFiles": "open",
  "java.imports.gradle.wrapper.checksums": [
    {
      "sha256": "49a7e1341eb2e32f746a60f7069642eba79a66e8fbdeccfe09fab50f3fa808e6",
      "allowed": true,
    },
  ],
  "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 4, ColumnLimit: 0}",
  "docker.extension.enableComposeLanguageServer": false,
  "git.enableSmartCommit": true,
  "window.autoDetectColorScheme": false,
  "cursor.composer.queueMessageDefaultBehavior": "steer",
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
  ],
}
