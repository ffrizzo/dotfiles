#!/bin/bash
{{ if ne .chezmoi.os "darwin" }}exit 0{{ end }}
set -euo pipefail
{{ if eq .chezmoi.os "darwin" }}
macos_version="{{ $p := splitList "." (output "sw_vers" "-productVersion" | trim) }}{{ index $p 0 }}{{ if ge (len $p) 2 }}.{{ index $p 1 }}{{ end }}"
{{ end }}

if ! command -v dockutil >/dev/null 2>&1; then
  eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv 2>/dev/null)" || true
fi

if ! command -v dockutil >/dev/null 2>&1; then
  echo "dockutil not found, skipping Dock setup"
  exit 0
fi

echo "Configuring Dock for macOS ${macos_version}..."
dockutil --remove all --no-restart

for app in \
  "/System/Applications/Mission Control.app" \
  "/System/Applications/System Settings.app"; do
  if [ -d "$app" ]; then
    dockutil --add "$app" --no-restart
  fi
done

for app in \
  "/Applications/Warp.app" \
  "/Applications/Cursor.app" \
  "/Applications/Visual Studio Code.app" \
  "/Applications/Claude.app" \
  "/Applications/Safari.app" \
  "/Applications/Brave Browser.app" \
  "/Applications/Google Chrome Dev.app" \
  "/Applications/Firefox Developer Edition.app" \
  "/Applications/Slack.app" \
  "/Applications/Discord.app" \
  "/Applications/Spotify.app" \
  "/Applications/Microsoft Outlook.app"; do
  if [ -d "$app" ]; then
    dockutil --add "$app" --no-restart
  fi
done

if [ -d "$HOME/Downloads" ]; then
  dockutil --add "$HOME/Downloads" --view grid --display stack --sort dateadded --no-restart
fi

killall Dock || true
