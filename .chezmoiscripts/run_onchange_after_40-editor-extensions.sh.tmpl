#!/bin/bash
{{ if ne .chezmoi.os "darwin" }}exit 0{{ end }}
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
set -euo pipefail

if ! command -v cursor >/dev/null 2>&1; then
  eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv 2>/dev/null)" || true
fi

if ! command -v cursor >/dev/null 2>&1; then
  echo "cursor not found, skipping Cursor extensions"
  exit 0
fi

echo "Installing Brewfile's vscode extensions into Cursor..."
grep -oE '^vscode "[^"]+"' "{{ .chezmoi.sourceDir }}/Brewfile" | sed -E 's/vscode "//;s/"//' | while read -r extension; do
  cursor --install-extension "$extension"
done
